# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# Supabase project URL and anon key (safe to expose to the client;
# access control is enforced by Postgres row-level security, not secrecy
# of these values). Find them in Supabase project settings > API.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key. Server-side only — never prefix with PUBLIC_,
# never send to the client, never log.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DeepSeek API key — Chiron's active scoring provider (ADR-007). Get one at
# https://platform.deepseek.com/api_keys. Server-side only.
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Anthropic API key — only needed if you switch the scoring provider back to
# AnthropicScoringProvider (still available behind the same ScoringProvider
# interface, just not the one wired up by default). Server-side only.
ANTHROPIC_API_KEY=sk-ant-your-key
